# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
e2e/fixtures/.auth.json
e2e/fixtures/.portal-auth.json
# Written by e2e/contrast.spec.ts on every run; a measurement, not a source file.
e2e/fixtures/.contrast-report.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev artifacts
.playwright-mcp/
/*.png

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma
/lib/generated/_tmp_prisma
/prisma/_gen_tmp.prisma
# stray dirs left by sandboxed builds where unlink/rmdir is blocked by the mount
/sessions

# machine-local agent settings
.claude/settings.local.json
.claude/worktrees/
.next-build/
.next-m4build/
tmp/

/test-results/
/playwright-report/

# session scratch — reads .secrets/, never commit
.tmp-tt-assisted.mjs
.seed-drafts-qa.ts

# CreatorCore extraction — login session + bulk data must never be committed
scripts/creatorcore/out/
scripts/creatorcore/.profile/

# Generated from the gitignored CreatorCore capture; carries real creator
# handles and reference-org campaign names. Regenerate with
# node scripts/creatorcore/cc-render-inventory.mjs > docs/CREATORCORE_UI_INVENTORY.md
docs/CREATORCORE_UI_INVENTORY.md

# local prod-maintenance probes and one-off scripts (never shipped)
scratchpad/

# Parity harness output.
#
# docs/parity/reference/**.json is the ONE thing here that cannot be
# regenerated without logging into someone else's product, so it is committed:
# 2.8MB of measured spec, and the reason no further CreatorCore login is needed.
# The viewport screenshots go with it as the visual record.
#
# Everything else is derived from a local run and would only bloat the repo:
#   *.full.png       29MB of full-page shots; the viewport crop is the useful one
#   docs/parity/ours 33MB, re-made by capture-ours.mjs in 40 seconds
#   review/          8MB of composites, re-made by review.mjs
#   structure/ critique/  per-run findings; the .md is the artefact, not the run
docs/parity/**/*.full.png
docs/parity/ours/
docs/parity/review/
docs/parity/history.jsonl
