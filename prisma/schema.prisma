generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum CampaignStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  COMPLETE
  CANCELLED
}

enum CampaignType {
  BUDGET_BASED
  VIEW_BASED
  OPEN_COMMUNITY
  PRIVATE_INVITE
}

enum Platform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  TWITTER
  FACEBOOK
  TWITCH
  THREADS
  PINTEREST
  SNAPCHAT
  LINKEDIN
}

enum ActivationStatus {
  AWAITING_DRAFT
  DRAFT_SUBMITTED
  AWAITING_APPROVAL
  APPROVED
  POSTING
  POSTED
  COMPLETE
  DECLINED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  PAYPAL
  BANK_TRANSFER
  UPI
  NEFT
  IMPS
  RTGS
  ENACH
  WIRE
}

enum PaymentMode {
  MANAGED
  SELF_MANAGED
}

enum PaymentRelease {
  MANUAL
  ON_POST_APPROVAL
  ON_CREATOR_REQUEST
}

enum PostApprovalMode {
  MANUAL
  AUTO_APPROVED
}

enum DepositStatus {
  PENDING
  HELD
  PARTIALLY_RELEASED
  FULLY_RELEASED
  REFUNDED
}

enum MediaType {
  REEL
  STORY
  POST
  SHORT
  VIDEO
}

enum PostStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// Whether the post still exists on the platform, as distinct from whether it is
// approved. CreatorCore tracks this separately (Success / Unavailable / Error)
// and the app's own /api/posts/inspect resolves the same three outcomes, so it
// is modelled as its own dimension rather than overloading PostStatus.
enum PostFetchState {
  LIVE
  UNAVAILABLE
  ERROR
  UNKNOWN
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

enum DepositPaymentMethod {
  CARD
  UPI
  NEFT
  IMPS
  RTGS
  ENACH
  WIRE
}

enum InviteChannel {
  INSTAGRAM_DM
  LINK
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum NegotiationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

enum OrgType {
  AGENCY
  BRAND
}

enum MessageSenderType {
  ORG
  CREATOR
  AI_AGENT
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Currency {
  USD
  EUR
  GBP
  INR
}

enum SyncSlotState {
  POOL
  ASSIGNED
  WARM
  COOLING
  RELEASED
  PINNED
}

enum FraudFlagType {
  VIEW_SPIKE
  LOW_ENGAGEMENT
  BOT_PATTERN
  GEOGRAPHIC_ANOMALY
}

enum FraudFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Organization & IAM ───────────────────────────────────────────────────────

model Organization {
  id                String    @id @default(cuid())
  name              String
  subdomain         String    @unique
  logoUrl           String?
  primaryColor      String    @default("#4F46E5")
  secondaryColor    String    @default("#1E1B4B")
  accentColor       String    @default("#F59E0B")
  fontFamily        String    @default("Inter")
  brandName         String?
  customDomain      String?   @unique
  faviconUrl        String?
  timezone          String    @default("UTC")
  plan              String    @default("starter")
  planExpiresAt     DateTime?
  syncSlotPoolSize  Int       @default(100)
  currency          Currency  @default(USD)
  orgType           OrgType   @default(AGENCY)
  uiConfig          Json? // OrgUIConfig — features, nav, branding, limits, dashboard widgets
  // Bank account
  bankAccountName   String?
  bankAccountNumber String?
  bankIFSC          String?
  bankSwift         String?
  bankRoutingNumber String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users               User[]
  campaigns           Campaign[]
  creators            Creator[]
  creatorLists        CreatorList[]
  clients             Client[]
  folders             Folder[]
  payoutBalances      PayoutBalance[]
  payouts             Payout[]
  tiktokSounds        TikTokSound[]
  connections         Connection[]         @relation("FromOrg")
  connectionsTo       Connection[]         @relation("ToOrg")
  reports             Report[]
  mediakits           MediaKit[]
  auditLogs           AuditLog[]
  plans               Plan[]
  planConfig          OrgPlanConfig?
  invites             UserInvite[]
  apiKeys             ApiKey[]
  campaignDeposits    CampaignDeposit[]
  creatorReviews      CreatorReview[]
  creatorTestimonials CreatorTestimonial[]
  conversations       Conversation[]
  songs               Song[]
  syncSlots           SyncSlot[]

  creatorTagDefs       CreatorTagDef[]
  creatorFlagDefs      CreatorFlagDef[]
  campaignTagDefs      CampaignTagDef[]
  deliverableTypeDefs  DeliverableTypeDef[]
  campaignStatusDefs   CampaignStatusDef[]
  activationStatusDefs ActivationStatusDef[]
}

/// A release that campaigns promote. One song runs across many campaigns, but a
/// campaign does not need one — Campaign.songId stays nullable so brand work and
/// one-off campaigns keep working exactly as before.
model Song {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  artist      String
  isrc        String?
  releaseDate DateTime?
  coverUrl    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  /// The TikTok sound this release is promoted with, if one is tracked. It hangs
  /// off the song rather than off the campaign because the usage curve belongs to
  /// the audio: three campaigns pushing the same release read the same tracker,
  /// and none of them owns it.
  soundId String?

  org       Organization @relation(fields: [orgId], references: [id])
  campaigns Campaign[]
  sound     TikTokSound? @relation(fields: [soundId], references: [id])

  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([soundId])
}

/// A campaign can run in waves — "4 phases of 10 posts each". Posts point at a
/// phase optionally, so campaigns that never use phases are unaffected and every
/// post predating this model keeps a null phaseId.
model CampaignPhase {
  id          String    @id @default(cuid())
  campaignId  String
  name        String
  /// 1-based running order within the campaign.
  sequence    Int
  startDate   DateTime?
  endDate     DateTime?
  targetPosts Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  posts    Post[]

  @@unique([campaignId, sequence])
  @@index([campaignId])
}

model User {
  id            String    @id @default(cuid())
  orgId         String
  email         String    @unique
  name          String
  avatarUrl     String?
  role          UserRole  @default(VIEWER)
  password      String?
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  invitedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org             Organization         @relation(fields: [orgId], references: [id])
  campaignMembers CampaignTeamMember[]
  comments        CampaignComment[]
  activityLogs    ActivityLog[]
  documents       Document[]
  briefsUpdated   CreativeBrief[]
  accounts        Account[]
  sessions        Session[]
  @@index([orgId])
}

model OrgPlanConfig {
  id           String   @id @default(cuid())
  orgId        String   @unique
  planName     String   @default("starter")
  maxCampaigns Int      @default(10)
  maxCreators  Int      @default(100)
  maxUsers     Int      @default(5)
  features     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model UserInvite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       UserRole  @default(MEMBER)
  token      String    @unique @default(cuid())
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  keyHash    String    @unique // SHA-256 hash — never store plaintext
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

model Campaign {
  id                        String                @id @default(cuid())
  orgId                     String
  title                     String
  status                    CampaignStatus        @default(DRAFT)
  campaignType              CampaignType          @default(BUDGET_BASED)
  typeConfig                Json? // shape varies per CampaignType + payout model
  selfServe                 Boolean               @default(false)
  platformFeeMinor          Int                   @default(0)
  enrollmentOpen            Boolean               @default(false)
  // ─── Whop-style marketplace (Phase 2M) ───────────────────────────────────
  // NOTE: All *Minor amounts below are integer MINOR units (cents/paise) per the
  // P3.1 payments convention — never floats. ratePerThousand is per-platform
  // minor units per 1k verified views, e.g. {"TIKTOK":150,"INSTAGRAM":150,"YOUTUBE":200}.
  marketplaceVisibility     MarketplaceVisibility @default(PRIVATE)
  publicSlug                String?               @unique // url-safe, generated server-side from title + nanoid on first publish to GLOBAL
  guidelines                String?               @db.Text // marketplace brief — creative guidelines
  requirements              String?               @db.Text // marketplace brief — participation requirements
  contentAssetsUrl          String? // link to downloadable assets (logos, footage, etc.)
  ratePerThousand           Json? // per-platform minor units per 1k verified views
  minPayoutMinor            Int? // minimum accrued (minor units) before a creator can request payout
  marketplaceBudgetCapMinor Int? // hard cap (minor units) on total marketplace accrual
  submissionDeadline        DateTime? // last date creators can submit posts
  autoApproveHours          Int                   @default(48) // hours before a PENDING submission auto-approves
  inviteCode                String? // shared join code for INVITE_ONLY campaigns (regenerated server-side only)
  thumbnailUrl              String?
  budget                    Float?
  currency                  Currency              @default(USD)
  notes                     String?
  clientId                  String?
  songId                    String?
  folderId                  String?
  createdById               String
  // Payment & approval config
  paymentMode               PaymentMode           @default(SELF_MANAGED)
  paymentRelease            PaymentRelease        @default(MANUAL)
  postApprovalMode          PostApprovalMode      @default(MANUAL)
  depositStatus             DepositStatus?
  // ─── CreatorCore parity ─────────────────────────────────────────────────────
  ccCampaignId              String?               @unique // source _id — re-sync key
  ccStatusId                String? // source org-activationstatus ref, kept verbatim
  ccFullId                  String? // source fullID, e.g. "279-92"
  ccSlug                    String? // source sudo-slug, for CreatorCore deep links
  archived                  Boolean               @default(false)
  refreshActive             Boolean? // whether CreatorCore auto-refreshes this campaign
  refreshInterval           Float?
  lastRefreshAt             DateTime?
  postRefreshAnchor         DateTime?
  creatorRateTotals         Float? // financial rollups CreatorCore computes per campaign
  commissionTotal           Float?
  profitTotal               Float?
  // The org's own granular status. Null means the `status` bucket above is the
  // whole answer, which is what all 521 pre-existing campaigns look like.
  statusDefId               String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  deletedAt                 DateTime?

  statusDef         CampaignStatusDef?   @relation(fields: [statusDefId], references: [id])
  tagLinks          CampaignTagLink[]
  org               Organization         @relation(fields: [orgId], references: [id])
  client            Client?              @relation(fields: [clientId], references: [id])
  song              Song?                @relation(fields: [songId], references: [id])
  phases            CampaignPhase[]
  folder            Folder?              @relation(fields: [folderId], references: [id])
  teamMembers       CampaignTeamMember[]
  tags              CampaignTag[]
  posts             Post[]
  activations       Activation[]
  brief             CreativeBrief?
  analytics         AnalyticsModule[]
  financials        CampaignFinancials?
  documents         Document[]
  comments          CampaignComment[]
  activityLogs      ActivityLog[]
  payouts           Payout[]
  reports           Report[]
  deposit           CampaignDeposit?
  campaignInvites   CampaignInvite[]
  payoutRequests    PayoutRequest[]
  negotiations      NegotiationOffer[]
  proposals         CampaignProposal[]
  creatorReviews    CreatorReview[]
  testimonials      CreatorTestimonial[]
  viewLedgerEntries ViewLedger[]
  fraudFlags        ViewFraudFlag[]
  conversations     Conversation[]
  syncSlots         SyncSlot[]
  // 80 call sites read this table and every one of them scopes by orgId; it had
  // no index at all. deletedAt rides along because the scope is almost always
  // "this org's live campaigns".
  @@index([orgId, deletedAt])
  @@index([clientId])
  @@index([folderId])
  @@index([songId])
}

/// A metered high-resolution polling slot — the scarce resource a plan sells.
/// Deliberately NOT called a Tracker: in this product a Tracker is CreatorCore's
/// social-listening entity (a TikTok sound or a creator, see TikTokSound and
/// SoundTrackerSnapshot), which is a subject you monitor, not a rationed slot.
/// The pool is org-level and recyclable, so campaignId stays nullable to let an
/// unassigned slot sit in POOL without belonging to a campaign yet. Settlement
/// polling is deliberately NOT gated on this model — a released slot must never
/// stop a campaign counting views its creators actually earned.
model SyncSlot {
  id         String        @id @default(cuid())
  orgId      String
  campaignId String?
  postId     String?       @unique
  state      SyncSlotState @default(POOL)
  assignedAt DateTime?
  releasedAt DateTime?
  pinnedAt   DateTime?
  hotUntil   DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  post         Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([orgId, state])
  @@index([campaignId])
}

model CampaignTeamMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  addedAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
}

model CampaignTag {
  campaignId String
  tag        String

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@id([campaignId, tag])
}

model CreativeBrief {
  id          String   @id @default(cuid())
  campaignId  String   @unique
  content     String
  version     Int      @default(1)
  updatedById String?
  updatedAt   DateTime @updatedAt

  campaign  Campaign @relation(fields: [campaignId], references: [id])
  updatedBy User?    @relation(fields: [updatedById], references: [id])
}

// ─── Creators ─────────────────────────────────────────────────────────────────

model Creator {
  id             String         @id @default(cuid())
  orgId          String
  name           String
  handle         String
  platform       Platform       @default(TIKTOK)
  platformUserId String?
  avatarUrl      String?
  followersCount Float          @default(0)
  averageViews   Float          @default(0)
  bio            String?
  contactEmail   String?
  paymentInfo    String?
  rate           Float?
  boostRate      Float?
  niches         CreatorNiche[]
  notes          String?
  addedAt        DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  // Watchlist membership for the Trackers page, mirroring TikTokSound.trackedSince.
  // A flag rather than a join table: a creator is tracked or not, the relation
  // carries no other attribute, and the row is already scoped to an org.
  trackedSince   DateTime?

  org            Organization           @relation(fields: [orgId], references: [id])
  listItems      CreatorListItem[]
  activations    Activation[]
  posts          Post[]
  payouts        Payout[]
  socialAccounts CreatorSocialAccount[]
  tagLinks       CreatorTagLink[]
  flagLinks      CreatorFlagLink[]

  @@index([orgId, trackedSince])
}

model CreatorSocialAccount {
  id             String    @id @default(cuid())
  creatorId      String
  platform       Platform
  handle         String
  accessToken    String // AES-256-GCM ciphertext at rest — lib/crypto/encrypt.ts (AAD = orgId)
  refreshToken   String? // AES-256-GCM ciphertext at rest — lib/crypto/encrypt.ts (AAD = orgId)
  tokenExpiry    DateTime?
  followersCount Float     @default(0)
  avgViews       Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
}

model CreatorList {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org   Organization      @relation(fields: [orgId], references: [id])
  items CreatorListItem[]
}

model CreatorListItem {
  id        String   @id @default(cuid())
  listId    String
  creatorId String
  addedAt   DateTime @default(now())

  list    CreatorList @relation(fields: [listId], references: [id])
  creator Creator     @relation(fields: [creatorId], references: [id])

  @@unique([listId, creatorId])
}

// ─── Activations ──────────────────────────────────────────────────────────────

model Activation {
  id                 String           @id @default(cuid())
  campaignId         String
  creatorId          String
  status             ActivationStatus @default(AWAITING_DRAFT)
  deliverableDueDate DateTime?
  postedUrl          String?
  feedbackNotes      String?
  draftUrl           String?
  draftCaption       String?
  draftMediaType     MediaType?
  draftSubmittedAt   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  // The org's own granular status. Null means the enum bucket above is the whole
  // answer, which is what every row imported before this existed looks like.
  statusDefId        String?

  campaign     Campaign             @relation(fields: [campaignId], references: [id])
  creator      Creator              @relation(fields: [creatorId], references: [id])
  posts        Post[]
  statusDef    ActivationStatusDef? @relation(fields: [statusDefId], references: [id])
  deliverables Deliverable[]
  // Joined per campaign by the roster and the share report.
  @@index([campaignId, deletedAt])
  @@index([creatorId])
}

// What a creator owes on one activation. The reference groups its activations
// board by whether these exist -- "In-Progress - Empty Deliverables" is a
// bucket -- so an activation with none is a normal state, not a broken one.
//
// One row per thing owed rather than a quantity, because two videos have two
// due dates and are finished separately.
model Deliverable {
  id           String    @id @default(cuid())
  activationId String
  // The org's own type from Settings, and a copy of what it was called. The
  // name is stored so deleting a definition leaves the deliverable readable
  // instead of blank; the link is SET NULL for the same reason.
  typeDefId    String?
  name         String
  dueDate      DateTime?
  completedAt  DateTime?
  notes        String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activation Activation          @relation(fields: [activationId], references: [id], onDelete: Cascade)
  typeDef    DeliverableTypeDef? @relation(fields: [typeDefId], references: [id], onDelete: SetNull)

  @@index([activationId])
  @@index([typeDefId])
}

// ─── Posts & Social Metrics ───────────────────────────────────────────────────

model Post {
  id                String          @id @default(cuid())
  campaignId        String
  creatorId         String
  activationId      String?
  phaseId           String?
  platform          Platform
  platformPostId    String
  postUrl           String
  thumbnailUrl      String?
  caption           String?
  mediaType         MediaType?
  postedAt          DateTime
  viewsCount        Float           @default(0)
  likesCount        Float           @default(0)
  commentsCount     Float           @default(0)
  sharesCount       Float           @default(0)
  downloadsCount    Float           @default(0)
  savesCount        Float           @default(0)
  reachCount        Float           @default(0)
  engagementRate    Float           @default(0)
  platformMetrics   Json?
  storyExpiresAt    DateTime?
  status            PostStatus      @default(PENDING_REVIEW)
  rejectionReason   String?
  lastSyncedAt      DateTime?
  syncFailCount     Int             @default(0)
  syncDisabledAt    DateTime?
  trackingEnabled   Boolean         @default(false)
  trackingStartedAt DateTime?
  // ─── CreatorCore parity ─────────────────────────────────────────────────────
  ccPostId          String?         @unique // source _id — re-sync key, idempotency
  fetchState        PostFetchState? // Success/Unavailable/Error — distinct from approval
  ccStatusRaw       String? // exact source string, so nothing is inferred away
  isInstagramStory  Boolean         @default(false)
  authorProfilePic  String?
  lastFreshAt       DateTime? // source lastFresh — when metrics were last refreshed
  autoAdded         Boolean         @default(false) // source autoAdd
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  campaign   Campaign             @relation(fields: [campaignId], references: [id])
  creator    Creator              @relation(fields: [creatorId], references: [id])
  activation Activation?          @relation(fields: [activationId], references: [id])
  phase      CampaignPhase?       @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  snapshots  PostMetricSnapshot[]
  syncSlot   SyncSlot?

  @@index([phaseId])
  // Post is the largest table in the app and every campaign screen filters on
  // campaignId, but nothing indexed it: each of those reads was scanning all
  // 18,725 rows to return the 17 belonging to one campaign.
  @@index([campaignId])
  @@index([creatorId])
  // 18,725 rows, and the activation is how a post is tied to its brief.
  @@index([activationId])
}

model PostMetricSnapshot {
  id               String   @id @default(cuid())
  postId           String
  viewsCount       Float    @default(0)
  likesCount       Float    @default(0)
  commentsCount    Float    @default(0)
  sharesCount      Float    @default(0)
  downloadsCount   Float    @default(0)
  savesCount       Float    @default(0)
  reachCount       Float    @default(0)
  impressionsCount Float    @default(0)
  engagementRate   Float    @default(0)
  platformMetrics  Json?
  syncSource       String?
  isFinalSnapshot  Boolean  @default(false)
  recordedAt       DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Read per post for the trend lines, and joined from Post for the whole
  // campaign at once by the share report.
  @@index([postId])
  @@index([postId, recordedAt])
}

model TikTokSound {
  id            String   @id @default(cuid())
  orgId         String
  tiktokSoundId String
  title         String
  artist        String
  coverImageUrl String?
  trackedSince  DateTime @default(now())
  createdAt     DateTime @default(now())

  org       Organization           @relation(fields: [orgId], references: [id])
  snapshots SoundTrackerSnapshot[]
  songs     Song[]
}

model SoundTrackerSnapshot {
  id             String   @id @default(cuid())
  soundId        String
  usesCount      Float
  videosAdded24h Int      @default(0)
  deltaUses24h   Int      @default(0)
  velocityScore  Float    @default(0)
  recordedAt     DateTime @default(now())

  sound TikTokSound @relation(fields: [soundId], references: [id])
}

// ─── Clients & Plans ──────────────────────────────────────────────────────────

model Plan {
  id          String   @id @default(cuid())
  name        String
  description String?
  features    Json     @default("{}")
  isCustom    Boolean  @default(false)
  orgId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id])
  clients Client[]
}

model Client {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  logoUrl          String?
  contactInfo      String?
  planId           String?
  featureOverrides Json?
  createdAt        DateTime @default(now())
