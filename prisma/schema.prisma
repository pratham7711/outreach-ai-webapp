  INVITE_ONLY // reachable only with an invite code
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum CreatorNiche {
  MUSIC
  FASHION
  TECH
  FITNESS
  BEAUTY
  FOOD
  TRAVEL
  GAMING
  COMEDY
  EDUCATION
  LIFESTYLE
  SPORTS
}

model CreatorUser {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  name              String
