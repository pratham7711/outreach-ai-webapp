// ─── CreatorCore raw mirror (full-fidelity import) ──────────────────────────────
// Every CreatorCore attribute lands here: known scalars as typed columns, arrays
// and objects as Json, and the complete untouched record in `raw` — so nothing is
// ever lost, including fields not (yet) promoted to a column. `ccId` is the source
// _id (idempotent upsert key); `orgId` scopes to our tenant. Populated by
// scripts/creatorcore/cc-import.mjs alongside the usable domain models.

model CcCampaign {
  id                          String    @id @default(cuid())
  orgId                       String
  ccId                        String    @unique // CreatorCore _id
  ccNumericId                 Float? // CreatorCore `id`
  fullId                      String?
  title                       String?
  status                      String?
  thumbnail                   String?
  urlPreview                  String?
  sudoSlug                    String?
  satellite                   String?
  organization                String? // CreatorCore org id (source system)
  currency                    String?
  budget                      Float?
  creatorRateTotals           Float?
  commissionTotal             Float?
  profitTotal                 Float?
  refreshInterval             Float?
  archive                     Boolean?
  refreshActive               Boolean?
  tempComplete                Boolean?
  viewMigrateComplete         Boolean?
  actionColumnAdded           Boolean?
  defaultDeliverableViewAdded Boolean?
  createdBy                   String?
  recentSnapshot              String?
  nextSnapshotWorkflow        String?
  createdDate                 DateTime?
  modifiedDate                DateTime?
  postRefreshAnchor           DateTime?
  lastRefresh                 DateTime?
  posts                       Json?
  activations                 Json?
  creatorProfiles             Json?
  metatags                    Json?
  modules                     Json?
  snapshots                   Json?
  activity                    Json?
  campaignManagers            Json?
  activationColumns           Json?
  views                       Json?
  displayPlatforms            Json?
  raw                         Json // complete original record
  importedAt                  DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([orgId])
}

model CcPost {
  id                    String    @id @default(cuid())
  orgId                 String
  ccId                  String    @unique // CreatorCore _id
  campaign              String? // CreatorCore campaign id
  organization          String?
  lastStatistics        String? // ref to CcStatisticPost.ccId
  latestViewsEngagement Float?
  platform              String?
  platformText          String?
  postUrl               String?
  status                String?
  thumbnail             String?
  username              String?
  authorProfilePic      String?
  createdBy             String?
  createdByUser         String?
  isInstagramStory      Boolean?
  autoAdd               Boolean?
  heicConvert           Boolean?
  postDate              DateTime?
  lastFresh             DateTime?
  createdDate           DateTime?
  modifiedDate          DateTime?
  raw                   Json
  importedAt            DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([orgId])
  @@index([campaign])
}

model CcStatisticPost {
  id         String   @id @default(cuid())
  orgId      String
  ccId       String   @unique
  raw        Json // full record — schema unknown until extracted, preserved whole
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId])
}

model CcRefreshQueue {
  id         String   @id @default(cuid())
  orgId      String
  ccId       String   @unique
  raw        Json
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId])
}

// Catch-all for any additional CreatorCore type the extractor reaches
// (activation, draft, story, …) so no type is ever dropped.
model CcRecord {
  id         String   @id @default(cuid())
  orgId      String
  ccType     String
  ccId       String
  raw        Json
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ccType, ccId])
  @@index([orgId])
}

// ─── Org-configurable taxonomy ────────────────────────────────────────────────
//
// The reference keeps tags, flags, deliverable types and statuses as rows an org
// creates in Settings, not as a fixed list in code. That is why statuses we kept
// finding -- Need To Invoice, Invoiced, Paid, Paused -- are configuration rather
// than a longer enum.
//
// Statuses are modelled as a name plus a bucket rather than replacing the
// existing enums, because our CampaignStatus values already ARE the reference's
// four buckets: PENDING/IN_PROGRESS/COMPLETE/CANCELLED to its
// Pending/Active/Complete/Canceled. So the enum column stays the bucket, every
// one of the 521 live campaigns keeps the status it has, and the granular status
// arrives as a nullable pointer alongside it. No backfill, and nothing to undo
// if a definition is later deleted -- the campaign falls back to its bucket.

model CreatorTagDef {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  org      Organization     @relation(fields: [orgId], references: [id])
  creators CreatorTagLink[]

  @@unique([orgId, name])
  @@index([orgId])
}

model CreatorTagLink {
  creatorId String
  tagId     String

  creator Creator       @relation(fields: [creatorId], references: [id])
  tag     CreatorTagDef @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([creatorId, tagId])
  @@index([tagId])
}

// Flags carry an emoji because the reference shows them as "⚡ Fast Turnaround"
// -- the glyph is part of the label, not decoration applied at render time.
model CreatorFlagDef {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  emoji     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  org      Organization      @relation(fields: [orgId], references: [id])
  creators CreatorFlagLink[]

  @@unique([orgId, name])
  @@index([orgId])
}

model CreatorFlagLink {
  creatorId String
  flagId    String

  creator Creator        @relation(fields: [creatorId], references: [id])
  flag    CreatorFlagDef @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@id([creatorId, flagId])
  @@index([flagId])
}

model CampaignTagDef {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  org       Organization      @relation(fields: [orgId], references: [id])
  campaigns CampaignTagLink[]

  @@unique([orgId, name])
  @@index([orgId])
}

model CampaignTagLink {
  campaignId String
  tagId      String

  campaign Campaign       @relation(fields: [campaignId], references: [id])
  tag      CampaignTagDef @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([campaignId, tagId])
  @@index([tagId])
}

model DeliverableTypeDef {
  id        String    @id @default(cuid())
  orgId     String
  name      String
  platform  Platform?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  org          Organization  @relation(fields: [orgId], references: [id])
  deliverables Deliverable[]

  @@unique([orgId, name])
  @@index([orgId])
}

model CampaignStatusDef {
  id        String         @id @default(cuid())
  orgId     String
  name      String
  // The fixed group this status sits under, and the column the app still
  // filters and reports on.
  bucket    CampaignStatus
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  org       Organization @relation(fields: [orgId], references: [id])
  campaigns Campaign[]

  @@unique([orgId, name])
  @@index([orgId, bucket])
}

model ActivationStatusDef {
  id        String           @id @default(cuid())
  orgId     String
  name      String
  bucket    ActivationStatus
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  org         Organization @relation(fields: [orgId], references: [id])
  activations Activation[]

  @@unique([orgId, name])
  @@index([orgId, bucket])
}
