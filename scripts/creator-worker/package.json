{
  "name": "outreach-creator-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plan B's TikTok page-fetch service, daily check and backup cron scheduler (zero dependencies), and the Top Posts grid reader.",
  "scripts": {
    "read": "node read-top-posts.mjs",
    "read:dry": "node read-top-posts.mjs --dry-run",
    "serve": "node fetch-server.mjs",
    "check": "node daily-check.mjs",
    "check:dry": "node daily-check.mjs --no-report",
    "schedule": "node backup-scheduler.mjs",
    "schedule:dry": "node backup-scheduler.mjs --dry-run",
    "test": "node --test fetch-server.test.mjs backup-scheduler.test.mjs"
  },
  "dependencies": {
    "playwright": "^1.58.2"
  }
}
