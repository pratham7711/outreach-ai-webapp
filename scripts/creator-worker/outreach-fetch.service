[Unit]
Description=Plan B page-fetch service for the tracker reader (tiktok.com pages only)
Documentation=file:///opt/outreach-creator-worker/creator-worker/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/outreach-creator-worker/creator-worker
ExecStart=/usr/bin/node fetch-server.mjs
# FETCH_TOKEN (and the TLS paths, if Caddy is not in front) live here,
# root-owned and chmod 600, so the token never appears in `ps`.
EnvironmentFile=/etc/outreach-fetch.env
Restart=always
RestartSec=5

User=creators
Group=creators
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/outreach-creator-worker
MemoryMax=256M

[Install]
WantedBy=multi-user.target
